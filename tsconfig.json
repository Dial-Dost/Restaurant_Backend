{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
  "module": "NodeNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
  "moduleResolution": "NodeNext",
  "verbatimModuleSyntax": true,
  "esModuleInterop": true,
  "allowSyntheticDefaultImports": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],

    // for decorators
    // "useDecorators": true
  },
  // jest-tests are compiled by ts-jest with tsconfig.jest.json (CommonJS/Node
  // resolution, where extensionless relative imports are valid). Exclude them from
  // the app's NodeNext typecheck, which would otherwise demand .js extensions.
  "exclude": ["node_modules", "build", "jest-tests"]
}
