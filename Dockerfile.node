# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Stage 1: Build
# Pinned to Node 22 (current LTS, "Jod") on Debian Bookworm slim so native
# packages like sharp and @node-rs/argon2 use prebuilt binaries against a stable
# glibc instead of compiling here.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder
WORKDIR /app

# Build tools for @node-rs/argon2. NOT libvips: sharp >= 0.33 ships its own as
# ordinary npm packages (@img/sharp-linux-x64 + @img/sharp-libvips-linux-x64,
# both recorded in package-lock.json), installs with no download and no compile
# step, and IGNORES a system libvips unless SHARP_FORCE_GLOBAL_LIBVIPS is set.
# libvips-dev used to be here for sharp 0.32, which preferred a global libvips
# and linked against it. That install path no longer exists, so the package would
# only cost build time and image size. Do not add it back.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Package manifests first, so a source-only change reuses the install layer.
# The asterisk stays, but it no longer means "the lockfile is optional": it means
# a missing lockfile reaches `npm ci` below, which says so in one clear line,
# instead of failing here as an unexplained cache-key error.
COPY package.json package-lock.json* tsconfig.build.json tsconfig.json ./

# `npm ci`, and deliberately with NO `|| npm install` fallback.
#
# docker-compose.yml names this file, so whatever resolves here is what runs in
# production. `npm install` re-resolves every semver range against the registry
# at build time, which means production could run a dependency tree that CI never
# tested. That is not hypothetical: on 2026-11-08 an install silently produced a
# different tree, reported success, and the build died two steps later.
# `npm ci` installs package-lock.json and nothing else, so the image matches the
# tree the tests ran against.
#
# A fallback would undo the whole point. `npm ci` fails in exactly one situation
# — the lockfile is missing, or out of step with package.json — and falling back
# to `npm install` there is choosing to ship the untested tree rather than say so.
# Let it fail. The fix is to commit the lockfile npm asks for, not to route
# around it.
#
# --include=dev because `npm run build` needs typescript. The dev tree is
# stripped again by `npm prune --omit=dev` further down, so nothing extra ships.
RUN npm ci --include=dev

# Prove the native addon actually LOADS before anything is shipped. `npm run
# build` below already fails when sharp is missing from node_modules, but a sharp
# that installed and cannot load its libvips would type-check fine and then throw
# during module evaluation at boot — and because `sharp` is a static top-level
# import (database_supabase.ts:28) that takes the whole server down, not just
# image processing. Dynamic import, not require: package.json is "type": "module".
RUN node -e "import('sharp').then((m) => console.log('sharp ok, libvips ' + m.default.versions.vips)).catch((e) => { console.error(e); process.exit(1); })"

# Copy source and build the TypeScript code (tsc -> build/index.js)
COPY . .
RUN npm run build

# Remove devDependencies, leaving only production packages in node_modules.
RUN npm prune --omit=dev

# ---------------------------------------------------------------------------
# Stage 2: Runtime
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim
WORKDIR /app

ENV NODE_ENV=production

# curl, for the container HEALTHCHECK. NOT libvips: sharp carries its own inside
# @img/sharp-libvips-linux-x64 and resolves it by RPATH, so a system libvips is
# ignored at runtime while still adding ~50 MB and a second copy to patch. The
# builder's `import('sharp')` check above is the proof — it runs in a stage with
# no system libvips at all, so a green build means this stage does not need one.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# "npm run migrate" executes scripts/migrate.ts via tsx at deploy time. tsx is a
# devDependency and is stripped from node_modules by "npm prune --omit=dev", so
# install it globally (pinned to match package.json) for the migration step.
RUN npm install -g tsx@4.19.2

# package.json (lets the app read its own version, and provides the npm scripts).
COPY --chown=node:node package.json package-lock.json* tsconfig.json ./

# Pruned production node_modules from the builder stage.
COPY --chown=node:node --from=builder /app/node_modules ./node_modules

# Compiled JS output (build/index.js).
COPY --chown=node:node --from=builder /app/build ./build

# Migration runner source + SQL files. migrate.ts resolves ../migrations
# relative to scripts/, so both directories must be present at runtime and
# must sit next to each other (scripts/ and migrations/ under /app).
COPY --chown=node:node --from=builder /app/scripts ./scripts
COPY --chown=node:node --from=builder /app/migrations ./migrations

# Drop privileges: the official node image ships a non-root "node" user (uid 1000).
USER node

# Railway assigns the port dynamically; the Node code listens on process.env.PORT
# (default 3001). Keep EXPOSE in sync with that default.
EXPOSE 3001

# Healthcheck hits the app's /health endpoint, which returns 503 when the DB is
# unreachable so the orchestrator stops routing traffic to a broken instance.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-3001}/health" || exit 1

# Start the server directly so `node` is PID 1 and receives SIGTERM from the
# orchestrator, driving the app graceful-shutdown handler (npm would swallow it).
# Run migrations as a RELEASE/pre-deploy step (`npm run migrate`, once per deploy
# as the OWNER) rather than per-replica here. Single-box: use `npm run start:prod`.
#
# Alternatively on Railway, set a release/pre-deploy command of
# "npm run migrate" and keep the start command as "npm start"; either path
# guarantees migrations land before the server accepts requests.
#
# THIS IS NOT OPTIONAL FOR MIGRATION 028 (tenant archiving). Because this CMD does
# not run migrations, 028_restaurant_archived_status.sql must be applied by the
# release step BEFORE this image serves traffic. Until it is, the operator
# console's Archive button is refused with a 503 naming the migration, and the
# server logs an error banner at boot. See platform/db.ts (archivedStatusSupported)
# and docs/DEPLOY_ORDER.md.
CMD ["node", "build/index.js"]
