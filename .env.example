# =============================================================================
# Restaurant Dash — Backend environment (.env.example)
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# Every variable below is read by the backend code (or by its build/migrate
# scripts / the Python feedback service). Vars marked REQUIRED must be set for a
# production deploy; optional vars have safe code defaults noted in the comment.
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================
# SECURITY POSTURE — least-privilege runtime role vs. owner migration role:
#   * The RUNTIME pool (this app at request time) MUST connect as the dedicated
#     `app_runtime` role created by migration 002. That role is NOSUPERUSER /
#     NOBYPASSRLS, so Row-Level Security is actually enforced and one tenant can
#     never read another tenant's rows.
#   * DDL / migrations connect as the table OWNER (superuser) via
#     MIGRATION_DATABASE_URL below. A superuser BYPASSES RLS, so it must NEVER be
#     used for the runtime pool — only by scripts/migrate.ts.
#
# Example (note the different roles):
#   runtime  : postgresql://app_runtime:RUNTIME_PW@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#   migration: postgresql://postgres:OWNER_PW@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# REQUIRED — runtime Postgres connection. First non-empty of these wins, in
# order: SUPABASE_DIRECT_URL > DATABASE_URL > DIRECT_URL. Point this at the
# least-privilege `app_runtime` role (NOT the postgres superuser).
SUPABASE_DIRECT_URL=postgresql://app_runtime:YOUR_RUNTIME_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional aliases (fallbacks for SUPABASE_DIRECT_URL; some tooling expects them).
# Leave pointing at the same app_runtime URL, or unset if SUPABASE_DIRECT_URL is set.
DATABASE_URL=${SUPABASE_DIRECT_URL}
DIRECT_URL=${SUPABASE_DIRECT_URL}

# Optional — IPv4-only fallback pool. Some hosts (e.g. Railway) can't reach
# Supabase's IPv6 direct host; set this to a pooler/IPv4 connection string and
# the backend transparently falls back to it. Also app_runtime.
# SUPABASE_IPV4_URL=postgresql://app_runtime:YOUR_RUNTIME_PASSWORD@HOST_IPV4:6543/postgres

# REQUIRED for migrations only — used EXCLUSIVELY by scripts/migrate.ts (npm run
# migrate). Must be the OWNER/superuser role so DDL can run. NEVER reuse for the
# runtime pool (superuser bypasses RLS). Falls back to SUPABASE_DIRECT_URL /
# DATABASE_URL / DIRECT_URL if unset, but set it explicitly for the secure split.
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_OWNER_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional — runtime pool sizing (all have code defaults).
# PG_POOL_MAX=                 # max runtime pool connections
# PG_IDLE_TIMEOUT_MS=          # idle client timeout
# PG_CONNECTION_TIMEOUT_MS=    # connect timeout

# Optional — refuse to boot if any tenant table is missing RLS. Set true in
# production to guarantee the secure posture is actually in place. Default off.
# ENFORCE_RLS_AT_BOOT=true


# =============================================================================
# SECURITY / SECRETS
# =============================================================================
# REQUIRED IN PRODUCTION — HMAC secret signing the table token in customer QR
# URLs. It is the only thing preventing a customer from forging ?t=/sig for any
# table of any restaurant on the public /qr endpoints. The server REFUSES TO
# BOOT in production if unset (a public dev fallback is used otherwise).
# Generate: openssl rand -base64 32
QR_SIGNING_SECRET=

# Optional — Supabase Storage uploads (logos, images). BOTH must be set or
# storage uploads are silently disabled. SUPABASE_DEFAULT_API_KEY is a service /
# storage API key — keep it secret.
# SUPABASE_PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_DEFAULT_API_KEY=

# Optional — Razorpay (online payment). If unset, /qr/:slug/razorpay/* endpoints
# return 503 (feature disabled). From your Razorpay dashboard. Keep secret.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=


# =============================================================================
# REDIS & SCALE
# =============================================================================
# Required for MULTI-REPLICA deploys — backs the session store, the rate
# limiter, and the socket.io adapter. When unset, sessions/rate-limit use an
# in-memory store: fine for a single local instance, but multiple replicas will
# NOT share sessions or realtime events. Set this in any production deploy.
REDIS_URL=redis://localhost:6379

# Optional — fail-fast guard: set true to refuse boot when REDIS_URL is unset.
# Recommended in production so you never silently run multi-replica on memory.
# REQUIRE_REDIS=true


# =============================================================================
# CORS
# =============================================================================
# Allowed browser origins (comma-separated). ALLOWED_ORIGINS is preferred;
# EXTRA_CORS_ORIGINS is a legacy alias (same effect). Include your dashboard and
# feedback app origins.
ALLOWED_ORIGINS=http://localhost:9002,http://localhost:3000,http://localhost:9003
# EXTRA_CORS_ORIGINS=   # legacy alias for ALLOWED_ORIGINS

# Optional — allow any *.up.railway.app origin. Default true; set false to lock
# CORS down to only ALLOWED_ORIGINS.
# ALLOW_RAILWAY_WILDCARD=false


# =============================================================================
# LIFECYCLE
# =============================================================================
# Optional — set "production" on deploys. Enables prod guards (e.g. QR secret
# enforcement) and disables demo seeding by default. Default: development.
# NODE_ENV=production

# Optional — HTTP port. Default 3001.
# PORT=3001

# Optional — seed the "CSR Organics" demo tenant on boot. Keep OFF in
# production. Default: off (and force-off when NODE_ENV=production).
# SEED_DEMO=true

# Optional — sliding session lifetime in seconds. Default 43200 (12h).
# SESSION_TTL_SECONDS=43200

# Optional — app self-update manifest served at GET /app/version. Bump
# APP_LATEST_VERSION on each release; clients below APP_MIN_VERSION are
# force-updated. iOS uses its App Store page URL.
APP_LATEST_VERSION=1.0.0
APP_MIN_VERSION=0.0.0
APP_UPDATE_NOTES=
APP_DOWNLOAD_WINDOWS=
APP_DOWNLOAD_ANDROID=
APP_DOWNLOAD_IOS=


# =============================================================================
# OBSERVABILITY (all optional — no-ops unless set)
# =============================================================================
# Structured-log level: trace|debug|info|warn|error|fatal. Default: info.
# LOG_LEVEL=info

# Per-request access log is ON by default; set to "off" to silence it.
# REQUEST_LOG=off

# Sentry error tracking. When unset, error capture is a no-op. APP_VERSION tags
# releases; SENTRY_TRACES_SAMPLE_RATE (0..1) enables perf tracing (default 0).
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# APP_VERSION=1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0

# Prometheus metrics are exposed at GET /metrics. If METRICS_TOKEN is set the
# endpoint requires "Authorization: Bearer <token>"; otherwise it's open (lock it
# down via private networking). Leave unset to keep /metrics open.
# METRICS_TOKEN=


# =============================================================================
# INTEGRATIONS
# =============================================================================
# Where the customer feedback form is hosted. The printed-bill QR and
# post-payment redirect point here, encoding the table's assigned waiter so the
# rating is credited to them. The form now lives inside the dashboard app at
# /feedback, so when unset the default is "<DASHBOARD_BASE_URL>/feedback"
# (dev: http://localhost:9002/feedback). Only set this to point at a separately
# hosted form (e.g. the deprecated standalone Restaurant_Feedback_UI app).
# FEEDBACK_BASE_URL=http://localhost:9002/feedback

# Python feedback/questions service (Python_servers). The backend proxies to it
# using PY_SERVER_URL (full URL) or, if unset, PY_SERVER_PORT on localhost.
# PY_SERVER_URL=http://localhost:5005
# PY_SERVER_PORT=5005

# OpenAI — required only for the voice receptionist + POST /realtime/session.
# If unset, those endpoints return 500 and the receptionist is disabled.
# OPENAI_API_KEY=sk-your-openai-key
# Optional — realtime model override. Default gpt-4o-realtime-preview.
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Voice receptionist tuning (all optional; defaults shown). Used by
# realtime_reception_agent.ts.
# RECEPTION_SERVER_URL=http://localhost:3000   # API base the agent calls back into
# RECEPTION_RESTAURANT_ID=default              # tenant the agent books for
# RECEPTION_BOOKING_DURATION=120               # minutes
# RECEPTION_BOOKING_SOURCE=Voice
# RECEPTION_OPENING_TIME=12:00 PM
# RECEPTION_CLOSING_TIME=11:00 PM

# GEMINI_API_KEY — NOT read by the Node backend. Only the Python feedback
# service (Python_servers/questions.py) uses it. Set it in that service's
# environment, not here, unless you run them together.
# GEMINI_API_KEY=


# =============================================================================
# PLATFORM CONTROL-PLANE (SaaS admin)
# =============================================================================
# Optional — control-plane pool for /platform/* (super-admin) endpoints. If
# unset, those endpoints are disabled. Connect as the `platform_runtime` role
# created by migration 004 (least-privilege, like app_runtime). First non-empty
# of PLATFORM_DATABASE_URL > PLATFORM_DIRECT_URL is used.
# PLATFORM_DATABASE_URL=postgresql://platform_runtime:YOUR_PLATFORM_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# PLATFORM_DIRECT_URL=${PLATFORM_DATABASE_URL}

# Optional — platform-admin session lifetime in seconds. Default 28800 (8h).
# PLATFORM_SESSION_TTL_SECONDS=28800

# Optional — control-plane pool max connections. Default applies if unset.
# (PG_IDLE_TIMEOUT_MS / PG_CONNECTION_TIMEOUT_MS from the DATABASE section are
# shared by this pool too.)
# PLATFORM_PG_POOL_MAX=

# --- Subscription billing -----------------------------------------------------
# Razorpay account for collecting SaaS SUBSCRIPTION fees from restaurants. This is
# YOUR platform account — separate from each restaurant's own Razorpay (which
# collects their dine-in payments). When unset, tenant self-serve online payment
# is disabled and invoices are confirmed manually by an operator (Billing → Mark
# paid in the platform console).
# PLATFORM_RAZORPAY_KEY_ID=
# PLATFORM_RAZORPAY_KEY_SECRET=

# Optional — auto-start a trial subscription (on the cheapest active plan) for each
# new restaurant signup. Default ON; set to false to assign every plan manually.
# SAAS_AUTO_TRIAL=false
# Optional — trial length in days (default 14).
# SAAS_TRIAL_DAYS=14
# Optional — grace days after a paid period lapses before the account is suspended
# (login still works during grace so the tenant can renew). Default 7.
# SAAS_GRACE_DAYS=7


# =============================================================================
# LEGACY / UNUSED — present in the tree but NOT read by the running backend.
# Listed here only so nobody re-adds them as "required". Do not set in prod.
# =============================================================================
# Test-only vars (used by files under test/, never by the server at runtime):
# BACKEND_API_BASE_URL, RESTAURANT_ID, EMPLOYEE_ID, TEST_RESTAURANT_ID,
# TEST_EMPLOYEE_ID, TEST_OUTLET_ID, TEST_A_RESTAURANT/USERNAME/PASSWORD,
# TEST_B_RESTAURANT/USERNAME/PASSWORD. Set them in your test environment only.
