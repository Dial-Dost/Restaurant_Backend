# Server environment variables
# Copy this file to .env and fill in the values

# Supabase Postgres direct connection string (required)
SUPABASE_DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional aliases used by some tools/libraries
DATABASE_URL=${SUPABASE_DIRECT_URL}
DIRECT_URL=${SUPABASE_DIRECT_URL}

# OpenAI Realtime (optional for realtime session endpoint)
OPENAI_API_KEY=sk-your-openai-key

# Allowed CORS origins (comma separated) - override if needed
ALLOWED_ORIGINS=http://localhost:9002,http://localhost:3000
