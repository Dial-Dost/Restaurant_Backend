# Server environment variables
# Copy this file to .env and fill in the values

# Mongo connection string (required)
MONGODB_URI=mongodb://localhost:27017
# Database name (optional; defaults to reception)
MONGODB_DB_NAME=reception

# OpenAI Realtime (optional for realtime session endpoint)
OPENAI_API_KEY=sk-your-openai-key

# Allowed CORS origins (comma separated) - override if needed
ALLOWED_ORIGINS=http://localhost:9002,http://localhost:3000
