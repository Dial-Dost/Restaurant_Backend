#!/bin/bash
# =============================================================================
# rd-entry — the forced command for the CI deploy SSH key.
#
# Installed in ~deploy/.ssh/authorized_keys as ONE line (see install.sh, and
# README.md "The exact authorized_keys line"):
#
#   restrict,command="/usr/local/sbin/rd-entry" ssh-ed25519 AAAA... ci-deploy
#
# This is what collapses the blast radius of a leaked DEPLOY_SSH_KEY. Without it,
# that key is shell access to a box holding live restaurant data. With it, the
# key's ENTIRE vocabulary is: read status, read the deployed git revision, read
# logs, ask whether migrations are pending, ask for the pending migrations to be
# applied, ask for an update (pull + rebuild), ask for a deploy, ask for a
# rollback. It cannot get a shell, cannot forward a port to Valkey or the
# database, and cannot cat an env file.
#
# `migrate` IS THE ONE THING THIS KEY CAN DO THAT IT COULD NOT BEFORE, and it is
# the only verb here that writes to the production database. What that costs, and
# why it is still bounded, is worth being precise about:
#
#   * It applies ONLY the .sql files already sitting in the box's working tree.
#     That tree is moved by exactly one thing — `update`, which resets to
#     FETCH_HEAD of a real clone fetched with a read-only deploy key. So a leaked
#     CI key cannot author SQL, cannot choose which SQL runs, and cannot point
#     the run at another database. It can only ask for migrations a maintainer
#     already merged to `main` to be applied sooner than someone intended.
#   * It takes no argument, so there is nothing to smuggle.
#   * It is idempotent: a second call finds nothing pending and exits 0 having
#     taken no dump and made no change.
#   * It dumps and verifies the dump before it applies anything, and refuses to
#     apply if that fails.
#
# That is a real widening and it should be weighed rather than waved through. The
# alternative it replaces is worse in practice: a human holding a root shell on
# the box for every release that carries SQL. See rd-deploy-migrate.proposed.sh.
#
# The client's command arrives in $SSH_ORIGINAL_COMMAND and is UNTRUSTED input.
# It is never eval'd, never passed to `sh -c`, and never word-split by the shell
# into a command line. It is character-whitelisted, then split into an argv
# array, then handed to `sudo -n /usr/local/sbin/rd-deploy`, which re-validates
# every argument itself.
#
# The grammar below mirrors the one /usr/local/sbin/rd-deploy already enforces
# (see WRAPPER_CONTRACT.md). Duplicated deliberately: two independent checks, so
# one mistake is not automatically a hole. If the wrapper's grammar ever changes,
# change this file, WRAPPER_CONTRACT.md and both deploy.yml files together.
#
# IT IS THE WRAPPER'S GRAMMAR MINUS TWO THINGS, AND MUST NEVER BE WIDER:
#
#   * no `valkey`. The wrapper accepts it; neither deploy.yml has ever sent it.
#     valkey is the shared cache — the one service whose restart is felt by
#     every till in every restaurant at once.
#   * no bare `update` / `deploy` / `rollback`. Without a service argument those
#     are the WHOLE stack — `compose build && up -d [--force-recreate]`. CI sends
#     `update python` then `update backend` from the backend repo, and
#     `update dashboard` from the dashboard repo. Nothing legitimate needs the
#     bare form, and requiring the argument means a leaked key cannot bounce
#     every till in every restaurant in one call.
#
# WHY CI SENDS `update` AND NEVER `deploy`: the transport is git. The box holds
# real clones of both repos and docker-compose.yml builds them as LOCAL BUILD
# CONTEXTS, so `deploy` (= `up -d`, no rebuild) would converge on the image
# already on disk and ship nothing while the pipeline reported success. `update`
# is the verb that fetches and rebuilds. `deploy` is kept in the grammar for a
# human converging the stack after editing compose by hand.
#
# Both narrowings only ever turn an ACCEPT into a 64. Anything this file accepts
# is still re-validated by the wrapper, so widening it here would not widen the
# wrapper — but narrowing it here does genuinely shrink what a leaked
# DEPLOY_SSH_KEY can reach, which is the whole reason this file exists.
#
# Must be root:root 0755 in a directory the `deploy` user cannot write.
# =============================================================================
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

EX_USAGE=64

cmd="${SSH_ORIGINAL_COMMAND:-}"
# Both must tolerate being unset: `set -u` would otherwise abort before any
# validation runs, and sshd is not the only way this file can be invoked.
peer="${SSH_CONNECTION:-}"
peer="${peer%% *}"

reject() {
  logger -t rd-entry -- "REJECTED from ${peer:-unknown}: $*" 2>/dev/null || true
  printf 'rd-entry: %s\n' "$*" >&2
  exit "$EX_USAGE"
}

if [ -z "$cmd" ]; then
  reject "interactive sessions are not permitted on this account"
fi

# Reject anything with an embedded newline before the line-oriented grep below
# ever sees it (grep would otherwise validate only the first line).
if [ "$(printf '%s' "$cmd" | wc -l)" -ne 0 ]; then
  reject "refused (embedded newline)"
fi

if [ "${#cmd}" -gt 64 ]; then
  reject "refused (over-long command)"
fi

# Whitelist, not blacklist. The entire grammar is lowercase words and hyphens
# separated by single spaces — no digests, no flags, no paths. So there is no
# quote, no '$', no backtick, no ';', no '/', no '.', and nothing to smuggle.
if ! printf '%s' "$cmd" | LC_ALL=C grep -qE '^[a-z]+(-[a-z]+)*( [a-z]+)?$'; then
  reject "refused (does not match the allowed grammar)"
fi

# Safe to word-split now: the charset above contains no IFS character other than
# the space, and no shell metacharacter at all.
read -r -a args <<<"$cmd"
if [ "${#args[@]}" -lt 1 ] || [ "${#args[@]}" -gt 2 ]; then
  reject "refused (expected one verb and at most one service)"
fi

verb="${args[0]}"
svc="${args[1]:-}"

# The vocabulary /usr/local/sbin/rd-deploy accepts, MINUS valkey and minus the
# bare deploy/rollback (see the header). Anything else would come back 64 from
# the wrapper anyway; rejecting it here keeps the wrapper from ever seeing it and
# makes the refusal auditable in syslog.
case "$verb" in
  # `migrate` belongs here and NOT with update/deploy/rollback: it is not
  # per-service. There is one database behind all three services, so a service
  # argument would be a lie the grammar accepted. Rejecting it keeps the caller
  # from ever believing it scoped anything.
  status|check-migrations|revision|migrate)
    [ -z "$svc" ] || reject "refused ('$verb' takes no service argument)"
    ;;
  # Read-only. A bare `logs` (the whole stack) changes nothing and is left
  # accepted; `logs valkey` is not, per the narrowing above.
  logs)
    if [ -n "$svc" ]; then
      case "$svc" in
        backend|dashboard|python) ;;
        valkey) reject "refused (valkey is out of this key's vocabulary)" ;;
        *) reject "refused (unknown service '$svc')" ;;
      esac
    fi
    ;;
  # A service argument is MANDATORY here. See the narrowing note in the header:
  # a bare deploy/rollback is the whole stack, valkey included, and no workflow
  # ever sends one.
  # `update` is the real deploy path: it pulls the repo and REBUILDS. It carries
  # the same mandatory-service rule and, in the wrapper, additionally refuses a
  # bare form and `valkey` (which has no repo to build from).
  deploy|rollback|update)
    if [ -z "$svc" ]; then
      reject "refused ('$verb' requires a service: backend, dashboard or python)"
    fi
    case "$svc" in
      backend|dashboard|python) ;;
      valkey) reject "refused (valkey is out of this key's vocabulary)" ;;
      *) reject "refused (unknown service '$svc')" ;;
    esac
    ;;
  *)
    reject "refused (unknown verb '$verb')"
    ;;
esac

logger -t rd-entry -- "ACCEPTED from ${peer:-unknown}: $cmd" 2>/dev/null || true

exec sudo -n /usr/local/sbin/rd-deploy "${args[@]}"
