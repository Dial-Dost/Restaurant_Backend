{
  "name": "server",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node ./build/index.js",
    "start:prod": "npm run migrate && node ./build/index.js",
    "start:full": "concurrently --kill-others --raw \"node ./build/index.js\" \"npm:run-python\"",
    "tsx-watch": "tsx watch index.ts",
    "run-python": "node scripts/run-python.js",
    "dev": "npm run tsx-watch",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lintfix": "eslint . --ext .ts,.tsx --max-warnings=0 --fix",
    "typecheck": "tsc --noEmit",
    "dev:full": "concurrently --kill-others --raw \"npm:tsx-watch\" \"npm:run-python\"",
    "build": "tsc --project tsconfig.build.json",
    "test:integration": "tsx test/integration/money_integration_test.ts",
    "test:allocation": "tsx test/allocation_roundtrip.ts",
    "test:overlap": "tsx test/overlap_allocation.ts",
    "test:threshold": "tsx test/capacity_threshold.ts",
    "test:valet_api": "tsx test/valet_api_test.ts",
    "test:feedback_api": "tsx test/feedback_api_test.ts",
    "test:password": "tsx test/password_hashing_test.ts",
    "test:isolation": "tsx test/tenant_isolation_test.ts",
    "test:routes": "tsx scripts/route_manifest.ts --check scripts/route_manifest.baseline.txt",
    "platform:create-admin": "tsx scripts/create-platform-admin.ts",
    "push:vapid-keys": "tsx scripts/generate-vapid-keys.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:dry": "tsx scripts/migrate.ts --dry-run",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "test:money": "jest test/money --runInBand",
    "test:ci": "npm run build && jest --runInBand",
    "aws:build:lambda": "docker build --platform linux/amd64 -f deploy/Dockerfile --target lambda -t cuisineflow:lambda .",
    "aws:build:realtime": "docker build --platform linux/amd64 -f deploy/Dockerfile --target realtime -t cuisineflow:realtime .",
    "aws:validate": "sam validate --lint --template deploy/template.yaml",
    "aws:deploy": "sam deploy --template-file deploy/template.yaml --config-file deploy/samconfig.toml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.15.0",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "concurrently": "^8.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-security": "^4.0.1",
    "jest": "^30.3.0",
    "ts-jest": "^29.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1111.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@node-rs/argon2": "^2.0.2",
    "@openai/agents": "^0.3.0",
    "@sentry/node": "^10.62.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.104.0",
    "@types/nodemailer": "^8.0.1",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.2.0",
    "nodemailer": "^10.0.8",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "sharp": "^0.32.1"
  }
}
