{
  // ts-jest transform config. The app builds as ESM (NodeNext + verbatimModuleSyntax),
  // but ts-jest compiles each test file in isolation to CommonJS, which is incompatible
  // with those settings. This override keeps the strict type-checking of the base config
  // while emitting CommonJS so jest can run the suite.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": false,
    "types": ["node", "jest"]
  }
}
